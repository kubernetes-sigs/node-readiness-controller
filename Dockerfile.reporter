FROM --platform=$BUILDPLATFORM golang:1.26.0 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace

COPY go.mod go.sum ./

RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o reporter ./cmd/readiness-condition-reporter/

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/reporter .
USER 65532:65532

ENTRYPOINT ["/reporter"]
