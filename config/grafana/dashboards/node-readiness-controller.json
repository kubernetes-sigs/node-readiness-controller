{
	"title": "Node Readiness Controller",
	"uid": "node-readiness-controller",
	"schemaVersion": 39,
	"version": 1,
	"editable": true,
	"graphTooltip": 1,
	"time": {
		"from": "now-6h",
		"to": "now"
	},
	"timezone": "browser",
	"tags": ["node-readiness-controller"],
	"panels": [
		{
			"id": 1,
			"type": "row",
			"title": "Fleet Overview",
			"collapsed": false,
			"gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
			"panels": []
		},
		{
			"id": 2,
			"type": "stat",
			"title": "Total Managed Nodes",
			"description": "Total nodes managed by NodeReadiness rules. If a node matches multiple rules, it is counted once for each matching rule.",
			"gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "sum(node_readiness_nodes_by_state)",
					"legendFormat": "Total",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"decimals": 0,
					"mappings": [],
					"thresholds": {
						"mode": "absolute",
						"steps": [{ "color": "text", "value": null }]
					}
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": ["lastNotNull"],
					"fields": "",
					"values": false
				},
				"orientation": "auto",
				"textMode": "auto",
				"colorMode": "value",
				"graphMode": "area",
				"justifyMode": "auto"
			}
		},
		{
			"id": 3,
			"type": "stat",
			"title": "Blocked Nodes",
			"description": "Nodes that are currently unavailable for scheduling because they are still bootstrapping or not yet ready.",
			"gridPos": { "h": 8, "w": 6, "x": 6, "y": 1 },
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "sum(node_readiness_nodes_by_state{state=~\"not_ready|bootstrapping\"})",
					"legendFormat": "Blocked",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"decimals": 0,
					"mappings": [],
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": null },
							{ "color": "red", "value": 1 }
						]
					}
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": ["lastNotNull"],
					"fields": "",
					"values": false
				},
				"orientation": "auto",
				"textMode": "auto",
				"colorMode": "value",
				"graphMode": "area",
				"justifyMode": "auto"
			}
		},
		{
			"id": 4,
			"type": "stat",
			"title": "Fleet Availability %",
			"description": "The percentage of managed nodes that are ready and available to run workloads.",
			"gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "sum(node_readiness_nodes_by_state{state=\"ready\"}) / sum(node_readiness_nodes_by_state) * 100",
					"legendFormat": "Availability",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percent",
					"decimals": 1,
					"min": 0,
					"max": 100,
					"mappings": [],
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "red", "value": null },
							{ "color": "yellow", "value": 80 },
							{ "color": "green", "value": 99 }
						]
					}
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": ["lastNotNull"],
					"fields": "",
					"values": false
				},
				"orientation": "auto",
				"textMode": "auto",
				"colorMode": "value",
				"graphMode": "area",
				"justifyMode": "auto"
			}
		},
		{
			"id": 5,
			"type": "stat",
			"title": "Rules Without Nodes",
			"description": "Rules whose node selector currently doesn't match any nodes. This may mean the selector is incorrect or the expected labels are missing.",
			"gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
			"datasource": { "type": "prometheus", "uid": "${datasource}" },
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "${datasource}" },
					"expr": "count(sum by (rule) (node_readiness_nodes_by_state) == 0) or vector(0)",
					"legendFormat": "Rules Without Nodes",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"decimals": 0,
					"mappings": [],
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": null },
							{ "color": "red", "value": 1 }
						]
					}
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": ["lastNotNull"],
					"fields": "",
					"values": false
				},
				"orientation": "auto",
				"textMode": "auto",
				"colorMode": "value",
				"graphMode": "area",
				"justifyMode": "auto"
			}
		},
		{
			"id": 18,
			"type": "row",
			"title": "Rule Health & Blocking",
			"collapsed": false,
			"gridPos": {
				"h": 1,
				"w": 24,
				"x": 0,
				"y": 9
			},
			"panels": []
		},
		{
			"id": 19,
			"type": "table",
			"title": "Blocking Conditions",
			"description": "Checks which conditions are currently blocking nodes, and how long they've been blocked. A node can appear under multiple conditions.",
			"gridPos": {
				"h": 9,
				"w": 24,
				"x": 0,
				"y": 10
			},
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"expr": "max by (rule, condition) (node_readiness_blocked_nodes{rule=~\"$rule\"})",
					"refId": "A",
					"format": "table",
					"instant": true
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"expr": "min_over_time(max by (rule, condition) (node_readiness_blocked_nodes{rule=~\"$rule\"})[30m:1m]) and count_over_time(max by (rule, condition) (node_readiness_blocked_nodes{rule=~\"$rule\"})[30m:1m]) >= 29",
					"refId": "B",
					"format": "table",
					"instant": true
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"expr": "100 * max by (rule, condition) (node_readiness_blocked_nodes{rule=~\"$rule\"}) / on (rule) group_left () (max by (rule) (node_readiness_rule_nodes{state=\"held\",rule=~\"$rule\"}) > 0)",
					"refId": "C",
					"format": "table",
					"instant": true
				}
			],
			"fieldConfig": {
				"defaults": {
					"custom": {
						"align": "auto",
						"filterable": false,
						"cellOptions": {
							"type": "auto"
						}
					},
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{
								"color": "text",
								"value": null
							}
						]
					},
					"mappings": []
				},
				"overrides": [
					{
						"matcher": {
							"id": "byName",
							"options": "Rule"
						},
						"properties": [
							{
								"id": "custom.width",
								"value": 330
							}
						]
					},
					{
						"matcher": {
							"id": "byName",
							"options": "Condition"
						},
						"properties": [
							{
								"id": "custom.width",
								"value": 360
							}
						]
					},
					{
						"matcher": {
							"id": "byName",
							"options": "Blocked now"
						},
						"properties": [
							{
								"id": "custom.width",
								"value": 130
							},
							{
								"id": "unit",
								"value": "short"
							},
							{
								"id": "decimals",
								"value": 0
							},
							{
								"id": "thresholds",
								"value": {
									"mode": "absolute",
									"steps": [
										{
											"color": "dark-green",
											"value": null
										},
										{
											"color": "dark-orange",
											"value": 1
										}
									]
								}
							},
							{
								"id": "custom.cellOptions",
								"value": {
									"type": "color-background",
									"mode": "gradient"
								}
							},
							{
								"id": "color",
								"value": {
									"mode": "thresholds"
								}
							},
							{
								"id": "description",
								"value": "Nodes held right now that don't meet this check yet."
							}
						]
					},
					{
						"matcher": {
							"id": "byName",
							"options": "Blocked for 30m+"
						},
						"properties": [
							{
								"id": "custom.width",
								"value": 170
							},
							{
								"id": "unit",
								"value": "short"
							},
							{
								"id": "decimals",
								"value": 0
							},
							{
								"id": "thresholds",
								"value": {
									"mode": "absolute",
									"steps": [
										{
											"color": "dark-green",
											"value": null
										},
										{
											"color": "dark-red",
											"value": 1
										}
									]
								}
							},
							{
								"id": "custom.cellOptions",
								"value": {
									"type": "color-background",
									"mode": "gradient"
								}
							},
							{
								"id": "color",
								"value": {
									"mode": "thresholds"
								}
							},
							{
								"id": "mappings",
								"value": [
									{
										"type": "special",
										"options": {
											"match": "null",
											"result": {
												"text": "warming up",
												"color": "rgba(216, 216, 209, 0.55)",
												"index": 0
											}
										}
									}
								]
							},
							{
								"id": "description",
								"value": "Nodes that have failed this check continuously for 30 minutes. 'warming up' means there isn't enough history yet."
							}
						]
					},
					{
						"matcher": {
							"id": "byName",
							"options": "% of held nodes"
						},
						"properties": [
							{
								"id": "custom.width",
								"value": 190
							},
							{
								"id": "unit",
								"value": "percent"
							},
							{
								"id": "decimals",
								"value": 1
							},
							{
								"id": "mappings",
								"value": [
									{
										"type": "special",
										"options": {
											"match": "null",
											"result": {
												"text": "n/a",
												"color": "rgba(216, 216, 209, 0.55)",
												"index": 0
											}
										}
									}
								]
							},
							{
								"id": "description",
								"value": "Share of the rule's held nodes failing this check. n/a means the rule isn't holding any nodes right now."
							}
						]
					}
				]
			},
			"options": {
				"showHeader": true,
				"cellHeight": "sm",
				"sortBy": [
					{
						"displayName": "Blocked now",
						"desc": true
					},
					{
						"displayName": "Blocked for 30m+",
						"desc": true
					}
				]
			},
			"transformations": [
				{
					"id": "merge",
					"options": {}
				},
				{
					"id": "organize",
					"options": {
						"excludeByName": {
							"Time": true,
							"__name__": true,
							"container": true,
							"endpoint": true,
							"instance": true,
							"job": true,
							"namespace": true,
							"pod": true,
							"service": true
						},
						"indexByName": {
							"rule": 0,
							"condition": 1,
							"Value #A": 2,
							"Value #B": 3,
							"Value #C": 4
						},
						"renameByName": {
							"rule": "Rule",
							"condition": "Condition",
							"Value #A": "Blocked now",
							"Value #B": "Blocked for 30m+",
							"Value #C": "% of held nodes"
						}
					}
				}
			]
		},
		{
			"id": 21,
			"type": "table",
			"title": "Rule Bottleneck Ranking",
			"description": "Shows how each rule is performing, including blocked nodes, taint failures, and release latency. Bottlenecks are ranked by how many nodes they're blocking.",
			"gridPos": {
				"h": 8,
				"w": 24,
				"x": 0,
				"y": 19
			},
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"targets": [
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"expr": "group by (rule) (node_readiness_rule_nodes{rule=~\"$rule\"})",
					"refId": "A",
					"format": "table",
					"instant": true
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"expr": "100 * sum by (rule) (rate(node_readiness_enforcement_latency_seconds_bucket{operation=\"remove\",le=~\"60(\\\\.0)?\",rule=~\"$rule\"}[15m])) / (sum by (rule) (rate(node_readiness_enforcement_latency_seconds_count{operation=\"remove\",rule=~\"$rule\"}[15m])) > 0) and on (rule) group by (rule) (node_readiness_rule_nodes{rule=~\"$rule\"})",
					"refId": "B",
					"format": "table",
					"instant": true
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"expr": "histogram_quantile(0.99, sum by (le, rule) (rate(node_readiness_enforcement_latency_seconds_bucket{operation=\"remove\",rule=~\"$rule\"}[15m]))) and on (rule) (sum by (rule) (rate(node_readiness_enforcement_latency_seconds_count{operation=\"remove\",rule=~\"$rule\"}[15m])) > 0) and on (rule) group by (rule) (node_readiness_rule_nodes{rule=~\"$rule\"})",
					"refId": "C",
					"format": "table",
					"instant": true
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"expr": "((sum by (rule) (increase(node_readiness_failures_total{rule=~\"$rule\",reason=~\"(?i)(add|remove)_?taint_?(error|conflict_?exhausted)\"}[10m])) and on (rule) group by (rule) (node_readiness_rule_nodes{rule=~\"$rule\"})) or on (rule) (0 * group by (rule) (node_readiness_rule_nodes{rule=~\"$rule\"})))",
					"refId": "D",
					"format": "table",
					"instant": true
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"expr": "100 * (sum by (rule) (increase(node_readiness_failures_total{rule=~\"$rule\",reason=~\"(?i)(add|remove)_?taint_?(error|conflict_?exhausted)\"}[15m])) or on (rule) (0 * sum by (rule) (increase(node_readiness_taint_operations_total{rule=~\"$rule\"}[15m])))) / (((sum by (rule) (increase(node_readiness_taint_operations_total{rule=~\"$rule\"}[15m])) or on (rule) (0 * sum by (rule) (increase(node_readiness_failures_total{rule=~\"$rule\",reason=~\"(?i)(add|remove)_?taint_?(error|conflict_?exhausted)\"}[15m])))) + (sum by (rule) (increase(node_readiness_failures_total{rule=~\"$rule\",reason=~\"(?i)(add|remove)_?taint_?(error|conflict_?exhausted)\"}[15m])) or on (rule) (0 * sum by (rule) (increase(node_readiness_taint_operations_total{rule=~\"$rule\"}[15m]))))) > 0) and on (rule) group by (rule) (node_readiness_rule_nodes{rule=~\"$rule\"})",
					"refId": "E",
					"format": "table",
					"instant": true
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"expr": "((sum by (rule) (increase(node_readiness_taint_operations_total{rule=~\"$rule\"}[30m])) and on (rule) group by (rule) (node_readiness_rule_nodes{rule=~\"$rule\"})) or on (rule) (0 * group by (rule) (node_readiness_rule_nodes{rule=~\"$rule\"})))",
					"refId": "F",
					"format": "table",
					"instant": true
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"expr": "((sum by (rule) (increase(node_readiness_enforcement_latency_seconds_count{operation=\"remove\",rule=~\"$rule\"}[15m])) and on (rule) group by (rule) (node_readiness_rule_nodes{rule=~\"$rule\"})) or on (rule) (0 * group by (rule) (node_readiness_rule_nodes{rule=~\"$rule\"})))",
					"refId": "G",
					"format": "table",
					"instant": true
				},
				{
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"expr": "((max by (rule) (node_readiness_rule_nodes{state=\"held\",rule=~\"$rule\"}) and on (rule) group by (rule) (node_readiness_rule_nodes{rule=~\"$rule\"})) or on (rule) (0 * group by (rule) (node_readiness_rule_nodes{rule=~\"$rule\"})))",
					"refId": "H",
					"format": "table",
					"instant": true
				}
			],
			"fieldConfig": {
				"defaults": {
					"custom": {
						"align": "auto",
						"filterable": false,
						"cellOptions": {
							"type": "auto"
						}
					},
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{
								"color": "text",
								"value": null
							}
						]
					},
					"mappings": []
				},
				"overrides": [
					{
						"matcher": {
							"id": "byName",
							"options": "Rule"
						},
						"properties": [
							{
								"id": "custom.minWidth",
								"value": 190
							}
						]
					},
					{
						"matcher": {
							"id": "byName",
							"options": "Held now"
						},
						"properties": [
							{
								"id": "custom.width",
								"value": 85
							},
							{
								"id": "unit",
								"value": "short"
							},
							{
								"id": "decimals",
								"value": 0
							},
							{
								"id": "description",
								"value": "Nodes this rule is holding back right now."
							}
						]
					},
					{
						"matcher": {
							"id": "byName",
							"options": "Taint churn (30m)"
						},
						"properties": [
							{
								"id": "custom.width",
								"value": 135
							},
							{
								"id": "unit",
								"value": "short"
							},
							{
								"id": "decimals",
								"value": 0
							},
							{
								"id": "description",
								"value": "Successful taint adds and removes in the last 30 minutes. High churn can mean nodes are flapping."
							}
						]
					},
					{
						"matcher": {
							"id": "byName",
							"options": "Taint failures (10m)"
						},
						"properties": [
							{
								"id": "custom.width",
								"value": 175
							},
							{
								"id": "unit",
								"value": "short"
							},
							{
								"id": "decimals",
								"value": 0
							},
							{
								"id": "thresholds",
								"value": {
									"mode": "absolute",
									"steps": [
										{
											"color": "dark-green",
											"value": null
										},
										{
											"color": "dark-red",
											"value": 1
										}
									]
								}
							},
							{
								"id": "custom.cellOptions",
								"value": {
									"type": "color-background",
									"mode": "gradient"
								}
							},
							{
								"id": "color",
								"value": {
									"mode": "thresholds"
								}
							},
							{
								"id": "description",
								"value": "Taint adds or removes that failed in the last 10 minutes."
							}
						]
					},
					{
						"matcher": {
							"id": "byName",
							"options": "Failure % (15m)"
						},
						"properties": [
							{
								"id": "custom.width",
								"value": 118
							},
							{
								"id": "unit",
								"value": "percent"
							},
							{
								"id": "decimals",
								"value": 1
							},
							{
								"id": "mappings",
								"value": [
									{
										"type": "special",
										"options": {
											"match": "null",
											"result": {
